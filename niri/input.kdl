// MOUSE & KEYBOARD

input {
    keyboard {
        xkb {
            layout "us,hu"
            options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"
        }
    }

    mouse {
        accel-speed -0.5
        accel-profile "flat"
    }

    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%" // doesnt switch to windows that are off-screen
}