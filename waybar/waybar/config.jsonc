{
    // LOCATION & SIZE
    "layer": "top",
    "height": 30,

    // MARGINS
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "margin-bottom": 0,

    // SPACING BETWEEN MODULES
    "spacing": 6,

    // MODULES
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "custom/zypper", "network", "bluetooth", "custom/brightness", "pulseaudio"],

    // DISPLAYS CURRENT WINDOW
    "niri/window": {
        "max-length": 80,
        "tooltip": false
    },

    // DDCUTIL BRIGHTNESS
    "custom/brightness": {
    "format": "{icon} {percentage}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "return-type": "json",
    "exec": "ddcutil -d 1 getvcp 10 | grep -oP 'current.*?=\\s*\\K[0-9]+' | { read x; echo '{\"percentage\":'${x}'}'; }",
    "on-scroll-up": "ddcutil --noverify -d 1 setvcp 10 + 10 && ddcutil --noverify -d 2 setvcp 10 + 10",
    "on-scroll-down": "ddcutil --noverify -d 1 setvcp 10 - 10 && ddcutil --noverify -d 2 setvcp 10 - 10",
    "on-click": "ddcutil --noverify -d 1 setvcp 10 0 && ddcutil --noverify -d 2 setvcp 10 0",
    "on-click-right": "ddcutil --noverify -d 1 setvcp 10 100 && ddcutil --noverify -d 2 setvcp 10 100",
    "interval": 1,
    "tooltip": false
    },

    // ZYPPER UPDATE COUNTER
    "custom/zypper": {
        "format": "{} ",
        "interval": 3600,
        "exec": "zypper lu | grep 'v \\+|' | wc -l; echo 'packages to update'",
        "exec-if": "exit 0",
        "on-click": "exec kitty -e sudo sh -c 'zypper ref; zypper dup; pkill -SIGRTMIN+8 waybar'",
        "signal": 8
    },

    // WORKSPACE SWITCHER`
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "○",
            "active": "●"
        }
    },

    // APP TRAY
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    // CLOCK
    "clock": {
        "format": "{:%Y. %b. %d. %R}",
        "interval": 10
    },

    // NETWORK
    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-linked": "",
        "format-disconnected": "⚠",
        "format-alt": "{ifname} {essid} ({signalStrength}%)",
        "on-click-right": "exec kitty -e nmtui"
    },

    // BLUETOOTH - half of it doesn't work
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "format-connected": " {num_connections}",
        //"format-connected": " {device_alias}",
        "tooltip-format": "{controller_address} {status}\n\n{num_connections} connected",
        "tooltip-format-disabled": "{status}",
        "tooltip-format-connected": "{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
        "on-click": "bluetooth toggle; pkill -SIGRTMIN+8 waybar",
        "on-click-right": "blueman-manager"
    },

    // AUDIO
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": " 0%",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "scroll-step": 10,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-click-middle": "bash /home/akos/toggle-sink.sh",
        "tooltip": true
    }
}